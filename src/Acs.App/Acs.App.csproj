<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AccessControlSystem</AssemblyName>
    <RootNamespace>Acs.App</RootNamespace>
    <Version>0.9.15</Version>
    <Product>Access Control System</Product>
    <ApplicationIcon>Assets\acs.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acs.Core\Acs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\acs.ico" />
    <!-- ui\test holds the node tests of the page helpers: not shipped with the app.
         ui\help\huong-dan.html is the user guide in docs\, built offline (guidebook build docs) and copied from
         docs\_site\index.html: rebuild and copy it whenever docs\ changes. -->

    <Content Include="ui\**\*" Exclude="ui\test\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
